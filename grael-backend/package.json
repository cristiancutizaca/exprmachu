{
  "name": "grael-backend",
  "version": "1.0.0",
  "description": "GRAEL - API Backend con PostgreSQL",
  "author": "GRAEL",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource=src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/run-seeds.ts",
    "seed:fresh": "node -r dotenv/config -e \"if (process.env.NODE_ENV === 'production' || process.env.ALLOW_DEMO_SEED !== 'true' || !/^exprmachu_test_/.test(process.env.DB_NAME || '')) throw Error('Seleccione una base de pruebas exprmachu_test_ y habilite ALLOW_DEMO_SEED')\" && npm run typeorm -- schema:drop && npm run migration:run && npm run seed",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "npm test",
    "test:concurrency": "node ../scripts/test-concurrency-v10.js",
    "test:integrity": "../scripts/check-data-integrity-v10.sh",
    "test:performance": "node ../scripts/performance-v10.js",
    "test:sunat": "node ../scripts/test-sunat-integracion.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/typeorm": "^12.0.3",
    "@types/qrcode": "^1.5.6",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "10.6.0",
    "dotenv": "^18.0.10",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "xml-crypto": "^6.4.0",
    "xmlbuilder2": "^4.0.3",
    "xmllint-wasm": "^5.3.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.30",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.7",
    "@types/yauzl": "^3.4.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.9"
  },
  "overrides": {
    "brace-expansion@1": "1.1.22",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    },
    "ts-jest": {
      "handlebars": "4.7.10"
    },
    "glob@^10.5.0": "14.0.6"
  }
}
